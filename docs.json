{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Hopscotch",
  "description": "OpenAI-compatible LLM router. One key, one endpoint, every model.",
  "colors": {
    "primary": "#00786a",
    "light": "#00c5a9",
    "dark": "#00786a"
  },
  "favicon": {
    "light": "/favicon/light.svg",
    "dark": "/favicon/dark.svg"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#f1f0ea",
      "dark": "#111110"
    }
  },
  "fonts": {
    "family": "Geist"
  },
  "icons": {
    "library": "tabler"
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": {
      "theme": {
        "light": "vitesse-light",
        "dark": "vesper"
      }
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://app.hopscotchlabs.ai"
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Get started",
        "icon": "player-play",
        "groups": [
          {
            "group": "First request",
            "pages": [
              "index",
              "get-started/quickstart",
              "get-started/authentication",
              "get-started/create-an-api-key"
            ]
          },
          {
            "group": "Coming from OpenAI",
            "pages": [
              "get-started/openai-compatibility",
              "get-started/migrate-from-openai"
            ]
          },
          {
            "group": "Your own provider keys",
            "pages": [
              "get-started/add-a-provider-key"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "resources/faq",
              "resources/glossary"
            ]
          }
        ]
      },
      {
        "tab": "Features",
        "icon": "stack-2",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "features/overview"
            ]
          },
          {
            "group": "Models",
            "pages": [
              "features/models",
              "features/model-capabilities",
              "features/model-lifecycle"
            ]
          },
          {
            "group": "Request features",
            "pages": [
              "features/streaming",
              "features/tool-calling",
              "features/structured-outputs",
              "features/image-inputs",
              "features/reasoning",
              "features/prompt-caching"
            ]
          },
          {
            "group": "Routing and reliability",
            "pages": [
              "features/routing-profiles",
              "features/bring-your-own-key",
              "features/errors"
            ]
          },
          {
            "group": "Try it",
            "pages": [
              "features/playground"
            ]
          }
        ]
      },
      {
        "tab": "Manage & monitor",
        "icon": "gauge",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "manage/overview"
            ]
          },
          {
            "group": "Usage",
            "pages": [
              "manage/usage-and-metering",
              "manage/monitor-usage",
              "manage/view-activity"
            ]
          },
          {
            "group": "Spend",
            "pages": [
              "manage/credits-and-billing",
              "manage/buy-credit",
              "manage/rate-limits-and-spend-controls",
              "manage/spend-controls"
            ]
          },
          {
            "group": "Workspace",
            "pages": [
              "manage/workspaces-and-members",
              "manage/create-a-workspace",
              "manage/invite-and-manage-members"
            ]
          },
          {
            "group": "Trust",
            "pages": [
              "manage/data-and-privacy",
              "manage/security"
            ]
          }
        ]
      },
      {
        "tab": "Integrations",
        "icon": "plug",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "integrations/overview"
            ]
          },
          {
            "group": "SDKs and frameworks",
            "pages": [
              "integrations/openai-sdk-python",
              "integrations/openai-sdk-node",
              "integrations/vercel-ai-sdk",
              "integrations/langchain",
              "integrations/llamaindex",
              "integrations/pydantic-ai"
            ]
          },
          {
            "group": "Coding agents",
            "pages": [
              "integrations/coding-harnesses",
              "integrations/claude-code",
              "integrations/cursor",
              "integrations/cline",
              "integrations/continue",
              "integrations/aider",
              "integrations/zed",
              "integrations/opencode",
              "integrations/codex-cli",
              "integrations/t3-code"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication",
              "api-reference/parameters",
              "api-reference/errors",
              "api-reference/headers"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "api-reference/openapi.public.json"
          }
        ],
        "icon": "code"
      }
    ]
  },
  "api": {
    "openapi": "api-reference/openapi.public.json",
    "playground": {
      "display": "interactive"
    }
  },
  "seo": {
    "indexing": "navigable"
  },
  "redirects": []
}
