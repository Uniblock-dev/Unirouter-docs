{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Uniblock",
  "description": "OpenAI-compatible LLM router. One key, one endpoint, every model.",
  "colors": {
    "primary": "#00786a",
    "light": "#00c5a9",
    "dark": "#00786a"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#f1f0ea",
      "dark": "#111110"
    }
  },
  "fonts": {
    "family": "Geist"
  },
  "icons": {
    "library": "tabler"
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": {
      "theme": {
        "light": "vitesse-light",
        "dark": "vesper"
      }
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://app.uniblock.dev"
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "get-started/quickstart",
              "get-started/openai-compatibility",
              "get-started/authentication"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "concepts/models",
              "concepts/model-capabilities",
              "concepts/model-lifecycle",
              "concepts/bring-your-own-key",
              "concepts/routing-profiles",
              "concepts/streaming",
              "concepts/tool-calling",
              "concepts/structured-outputs",
              "concepts/image-inputs",
              "concepts/reasoning",
              "concepts/prompt-caching",
              "concepts/credits-and-billing",
              "concepts/usage-and-metering",
              "concepts/rate-limits-and-spend-controls",
              "concepts/errors",
              "concepts/workspaces-and-members",
              "concepts/data-and-privacy"
            ]
          },
          {
            "group": "Dashboard guides",
            "pages": [
              "guides/create-an-api-key",
              "guides/add-a-provider-key",
              "guides/buy-credit",
              "guides/monitor-usage",
              "guides/view-activity",
              "guides/create-a-workspace",
              "guides/invite-and-manage-members",
              "guides/playground",
              "guides/spend-controls"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/overview",
              "integrations/openai-sdk-python",
              "integrations/openai-sdk-node",
              "integrations/vercel-ai-sdk",
              "integrations/langchain",
              "integrations/llamaindex",
              "integrations/pydantic-ai",
              "integrations/coding-harnesses",
              "integrations/cline",
              "integrations/continue",
              "integrations/aider",
              "integrations/zed",
              "integrations/opencode"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "resources/migrate-from-openai",
              "resources/faq",
              "resources/security",
              "resources/glossary"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication",
              "api-reference/parameters",
              "api-reference/errors",
              "api-reference/headers"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "api-reference/openapi.public.json"
          }
        ]
      }
    ]
  },
  "api": {
    "openapi": "api-reference/openapi.public.json",
    "playground": {
      "display": "interactive"
    }
  },
  "seo": {
    "indexing": "navigable"
  },
  "redirects": []
}
